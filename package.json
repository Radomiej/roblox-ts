{
	"name": "@radomiej/roblox-ts",
	"version": "3.2.0-alechemy",
	"description": "A TypeScript-to-Luau Compiler for Roblox",
	"main": "out/CLI/index.js",
	"browser": "out/CLI/browser.js",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Radomiej/roblox-ts.git"
	},
	"bin": {
		"rbxtsc": "out/CLI/cli.js"
	},
	"scripts": {
		"prepublishOnly": "npm run build",
		"build": "tspc -b",
		"build-watch": "tspc -b -w",
		"eslint": "eslint --max-warnings 0",
		"devlink": "npm run build && cd devlink && npm link",
		"update-test-types": "cd tests && npm install -D @rbxts/compiler-types@file:../../compiler-types && npm install @rbxts/types@latest",
		"test": "npm run build && npm run test-compile && npm run test-rojo && npm run test-run && npm run test:js && npm run test:sourcemap && npm run test:property",
		"test-compile": "jest --coverage --maxWorkers=2",
		"test-rojo": "rojo build tests -o ./tests/test.rbxl",
		"test-run": "lune run ./tests/runTestsWithLune.luau ./tests/test.rbxl",
		"test-roblox": "npm run build && npm run test-compile && npm run test-rojo && npm run run-in-roblox",
		"run-in-roblox": "run-in-roblox --place ./tests/test.rbxl --script ./tests/out/main.server.luau",
		"prepare": "npm run build",
		"test:js": "jest --config jest.js-support.config.ts --runInBand",
		"test:js:coverage": "npm run test:js -- --coverage",
		"test:mutation": "stryker run stryker.js-support.config.mjs",
		"lint:js": "eslint --max-warnings 0 src/Project/functions/createPathTranslator.ts src/Project/functions/copyItem.ts src/Project/functions/setupProjectWatchProgram.ts src/Project/util/isCompilableFile.ts && prettier --check tests/js-support jest.js-support.config.ts jest.mutation.config.ts stryker.js-support.config.mjs",
		"test:ts:mutation": "stryker run stryker.ts.config.mjs",
		"test:ts:regression": "jest --config jest.ts-mutation.config.ts --runInBand",
		"eslint:ci": "eslint --max-warnings 0",
		"test:sourcemap": "lune run tests/sourcemap-runtime.test.luau",
		"test:property": "npm run test:property:types && jest --config jest.property.config.ts --runInBand",
		"test:planner:mutation": "stryker run stryker.prereqs.config.mjs",
		"test:property:mutation": "stryker run stryker.property.config.mjs",
		"test:property:types": "tsc --noEmit -p tests/property/tsconfig.json"
	},
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@roblox-ts/luau-ast": "=2.1.2",
		"@roblox-ts/path-translator": "=1.1.1",
		"@roblox-ts/rojo-resolver": "=1.3.0",
		"chokidar": "^4.0.3",
		"fs-extra": "^11.4.1",
		"kleur": "^4.1.5",
		"luaparse": "^0.3.1",
		"resolve": "^1.22.12",
		"typescript": "=5.9.3",
		"yargs": "^18.2.0"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
		"@eslint/js": "^10.0.1",
		"@rbxts/compiler-types": "file:../compiler-types",
		"@stryker-mutator/core": "10.1.1",
		"@stryker-mutator/jest-runner": "10.1.1",
		"@types/fs-extra": "^11.0.4",
		"@types/jest": "^30.0.0",
		"@types/luaparse": "^0.2.3",
		"@types/node": "^26.6.3",
		"@types/prompts": "^2.4.9",
		"@types/resolve": "^1.20.6",
		"@types/ts-expose-internals": "npm:@roblox-ts/ts-expose-internals@=5.9.3",
		"@types/yargs": "^17.0.35",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"fast-check": "4.10.2",
		"jest": "^30.5.2",
		"jiti": "^2.7.0",
		"prettier": "^3.9.9",
		"ts-jest": "^29.4.14",
		"ts-node": "^10.9.2",
		"ts-patch": "^3.3.0",
		"typescript-eslint": "^8.70.1",
		"typescript-transform-paths": "^4.0.0"
	},
	"files": [
		"out",
		"include",
		"CHANGELOG.md",
		"!**/*.js.map",
		"!**/*.tsbuildinfo"
	]
}
